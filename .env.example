# Peluquería SHADU — Variables de configuración
# Copiar este archivo como .env y completar los valores reales
# NUNCA subir .env a git (ya está en .gitignore)

# Google Analytics 4 — Measurement ID
# Obtener en: analytics.google.com → Administrar → Flujos de datos → tu flujo → Measurement ID
# Formato: G-XXXXXXXXXX
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Business Profile
# URL de tu perfil en Google Maps (ej: https://maps.app.goo.gl/...)
GBP_URL=https://maps.app.goo.gl/kheGBfbdUnJetxiU8

# Coordenadas reales del local (verificar en Google Maps)
# Buscar "Carrera 90H #91-52 Bogotá" en maps.google.com, clic derecho → "¿Qué hay aquí?"
GEO_LATITUDE=4.6975
GEO_LONGITUDE=-74.1118
